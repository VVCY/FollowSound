<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D12"
    android:orientation="vertical">

    <WebView
        android:id="@+id/web"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!--
              用 TextView + 背景 selector，而不是原生 Button：
              Button 在 AppCompat 主题下自带 backgroundTint、inset 和海拔阴影，
              圆角会被裁、按下状态也压不住，怎么调都还是"系统设置"那一套观感。
            -->
            <TextView
                android:id="@+id/overlayBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/overlay_on"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/updateBtn"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:letterSpacing="0.02"
                android:text="@string/check_update"
                android:textColor="#C6CEDA"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:textColor="#59616F"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
